# LLM Provider selection: gemini, groq, or ollama
LLM_PROVIDER=gemini

# If using Gemini (free tier from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# If using Groq (free tier from https://console.groq.com)
# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.3-70b-versatile

# If using local Ollama
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# Crawler settings
CRAWLER_CONTACT=founder@example.com
CRAWL_DELAY_SECONDS=2

